# Google Maps API key (required for map tiles on iOS and Android)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# StormGlass API key (for tide/weather data)
EXPO_PUBLIC_STORMGLASS_API_KEY=your_stormglass_api_key_here

# Mapbox — SECRET token for downloading the SDK at build time (must start with sk.)
MAPBOX_DOWNLOADS_TOKEN=sk.your_mapbox_downloads_token_here

# Mapbox — PUBLIC token used in the app UI (must start with pk.)
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# RevenueCat API keys
REVENUECAT_APPLE_KEY=appl_your_revenuecat_apple_key_here
REVENUECAT_GOOGLE_KEY=goog_your_revenuecat_google_key_here

# Firebase App Check — debug token for DEV builds only
# Generate this token by running the app in __DEV__ mode and checking the console output.
# Then register it in Firebase Console → App Check → Apps → <your app> → Debug tokens.
# The EXPO_PUBLIC_ prefix makes it accessible inside the Metro bundle at build time.
EXPO_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN=your_debug_token_here

# DFO test ELOG key (Ticket #2126, received June 10 2026) — used by the DEV-only
# "Validate ELOG Key (UAT)" card in DfoTestHarnessScreen. Uppercase, 24+ chars.
EXPO_PUBLIC_DFO_TEST_ELOG_KEY=
