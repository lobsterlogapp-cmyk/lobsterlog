<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>LobsterLog</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.10.0</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lobsterlog</string>
				<string>com.Nickerson.LobsterLog</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>exp+lobsterlog</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>76</string>
	<key>GMSApiKey</key>
	<string>AIzaSyCAHiG7LSZmQPlU7QWNAD0tLRLJVMGN87U</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSMinimumSystemVersion</key>
	<string>12.0</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- S151, defect 99. Pairs with UIFileSharingEnabled below: together they make the app's
	     Documents folder browsable in the Files app, which is where the Delete Account export
	     is written (src/utils/exportTransmissionRecord.ts, exportDir() → DocumentDir). Without
	     BOTH, the file persists but the harvester cannot reach it.
	     ⚠ THE SAME TWO KEYS ARE ALSO DECLARED IN app.config.js (ios.infoPlist). That duplication
	     is knowingly accepted, not engineered around: this file is what the build reads (ios/ is
	     committed and nothing regenerates it in this workflow), and app.config.js is what a future
	     `expo prebuild` would read. The two can drift. If you change one, change the other. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>LobsterLog needs your location to track your trawls even when the app is in the background.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Allow $(PRODUCT_NAME) to access your location</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>LobsterLog uses your location to show your boat's position on the chart and log your catches.</string>
	<key>RCTNewArchEnabled</key>
	<false/>
	<!-- S151, defect 99. Pairs with LSSupportsOpeningDocumentsInPlace above — see the note there.
	     ⚠ ALSO DECLARED IN app.config.js (ios.infoPlist); the two copies can drift. Change both. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>SplashScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
